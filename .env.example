# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authapp

# Auth
JWT_SECRET=your-secret-key-change-in-production

# API
PORT=4000
API_BASE_URL=http://localhost:4000

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# ─── Email ────────────────────────────────────────────────
# Switch provider: console (dev logs) | smtp (real emails)
MAIL_PROVIDER=console
MAIL_FROM=TechHub BD <noreply@techhubbd.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Payment Gateway ──────────────────────────────────────
# Switch provider: sslcommerz | bkash
PAYMENT_GATEWAY=sslcommerz
SSL_STORE_ID=
SSL_STORE_PASS=
SSL_SANDBOX=true

# bKash (when PAYMENT_GATEWAY=bkash)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ─── Upload Provider ──────────────────────────────────────
# Switch provider by changing UPLOAD_PROVIDER: local | cloudinary | s3
UPLOAD_PROVIDER=local

# Cloudinary (when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (when UPLOAD_PROVIDER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
