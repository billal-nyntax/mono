{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @repo/database build && pnpm --filter @repo/auth-core build && pnpm --filter @repo/mailer build && pnpm --filter @repo/auth-better-auth build && pnpm --filter @repo/payment build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "@repo/auth-better-auth": "workspace:*",
    "@repo/auth-core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/mailer": "workspace:*",
    "@repo/payment": "workspace:*",
    "@repo/upload": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "typescript": "5.9.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.1.0"
  }
}
